{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "semi": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "tools/oxlint/anti-slop/",
    "docs/design/",
    "pnpm-lock.yaml"
  ]
}
